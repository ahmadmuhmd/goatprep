# Copy into .env.local. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Only needed locally for migration/account synchronization:
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Neon pooled connection string from Connect:
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
ADMIN_EMAILS=your-google-email@example.com

# Your approved Desmos API key. Browser-facing by design.
NEXT_PUBLIC_DESMOS_API_KEY=

# Offline content generation only; never called while students take tests.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_AUDIT_MODEL=

# Off by default: Jerry uses the local approved lesson library.
# Enable only with a provider whose terms cover your audience and a free quota.
# OpenAI-compatible chat-completions endpoint; Google Gemini API is not suitable
# for this under-18-directed site under its current terms.
JERRY_ENABLED=false
JERRY_API_URL=
JERRY_API_KEY=
JERRY_MODEL=
JERRY_DAILY_LIMIT=10

# Python generator final editorial pass (legacy model ID).
OPENROUTER_EDITOR_MODEL=google/gemini-3.7-flash

# Local migration only; omit for a fresh application:
SOURCE_DATABASE_URL=
